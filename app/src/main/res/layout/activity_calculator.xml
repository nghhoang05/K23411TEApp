<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_background"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".CalculatorActivity">

    <!-- Display Area -->
    <EditText
        android:id="@+id/edtFormular"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="bottom|end"
        android:hint="0"
        android:focusable="false"
        android:clickable="false"
        android:longClickable="false"
        android:inputType="none"
        android:padding="24dp"
        android:textColor="@color/calc_text_primary"
        android:textColorHint="@color/calc_text_secondary"
        android:textSize="56sp"
        tools:text="1,234" />

    <!-- Memory Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/calc_button_background"
        android:backgroundTint="@color/calc_memory_bg"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView android:id="@+id/txtMC" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="12dp" android:text="@string/str_mc" android:textAlignment="center" android:textColor="@color/calc_text_secondary" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtMR" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="12dp" android:text="@string/str_mr" android:textAlignment="center" android:textColor="@color/calc_text_secondary" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtMplus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="12dp" android:text="@string/str_mplus" android:textAlignment="center" android:textColor="@color/calc_text_secondary" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtMminus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="12dp" android:text="@string/str_mminus" android:textAlignment="center" android:textColor="@color/calc_text_secondary" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtMS" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="12dp" android:text="@string/str_ms" android:textAlignment="center" android:textColor="@color/calc_text_secondary" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtM" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:padding="12dp" android:text="@string/str_m" android:textAlignment="center" android:textColor="@color/calc_text_secondary" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">

        <!-- Row 1 -->
        <TableRow android:layout_marginBottom="8dp">
            <Button android:id="@+id/btnPercent" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_function" android:text="@string/btn_percent" android:textAllCaps="false" android:textColor="@color/calc_text_primary" android:textSize="18sp" />
            <Button android:id="@+id/btnCE" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_function" android:text="@string/btn_ce" android:textAllCaps="false" android:textColor="@color/calc_text_primary" android:textSize="18sp" />
            <Button android:id="@+id/btnC" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_function" android:text="@string/btn_c" android:textAllCaps="false" android:textColor="@color/calc_text_primary" android:textSize="18sp" />
            <Button android:id="@+id/btnDel" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_function" android:text="@string/btn_del" android:textColor="@color/calc_text_primary" android:textSize="20sp" />
        </TableRow>

        <!-- Row 2 -->
        <TableRow android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn1_x" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_function" android:text="@string/btn_inv" android:textAllCaps="false" android:textColor="@color/calc_text_primary" android:textSize="18sp" />
            <Button android:id="@+id/x_2" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_function" android:text="@string/btn_sqr" android:textAllCaps="false" android:textColor="@color/calc_text_primary" android:textSize="18sp" />
            <Button android:id="@+id/btnsqrt" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_function" android:text="@string/btn_sqrt" android:textAllCaps="false" android:textColor="@color/calc_text_primary" android:textSize="18sp" />
            <Button android:id="@+id/btndiv" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_operator" android:onClick="processInputData" android:text="@string/btn_div" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
        </TableRow>

        <!-- Numbers -->
        <TableRow android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn7" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_background" android:onClick="processInputData" android:text="7" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
            <Button android:id="@+id/btn8" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_background" android:onClick="processInputData" android:text="8" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
            <Button android:id="@+id/btn9" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_background" android:onClick="processInputData" android:text="9" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
            <Button android:id="@+id/btnmulti" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_operator" android:onClick="processInputData" android:text="@string/btn_mul" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
        </TableRow>

        <TableRow android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn4" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_background" android:onClick="processInputData" android:text="4" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
            <Button android:id="@+id/btn5" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_background" android:onClick="processInputData" android:text="5" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
            <Button android:id="@+id/btn6" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_background" android:onClick="processInputData" android:text="6" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
            <Button android:id="@+id/btnsub" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_operator" android:onClick="processInputData" android:text="@string/btn_sub" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
        </TableRow>

        <TableRow android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn1" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_background" android:onClick="processInputData" android:text="1" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
            <Button android:id="@+id/btn2" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_background" android:onClick="processInputData" android:text="2" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
            <Button android:id="@+id/btn3" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_background" android:onClick="processInputData" android:text="3" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
            <Button android:id="@+id/btnplus" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_operator" android:onClick="processInputData" android:text="@string/btn_add" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
        </TableRow>

        <TableRow>
            <Button android:id="@+id/btnsign" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_background" android:text="@string/btn_sign" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
            <Button android:id="@+id/btn0" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_background" android:onClick="processInputData" android:text="0" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
            <Button android:id="@+id/btnpoint" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_background" android:onClick="processInputData" android:text="@string/btn_dot" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
            <Button android:id="@+id/btnCalculate" style="@style/Widget.AppCompat.Button.Borderless" android:layout_margin="4dp" android:background="@drawable/calc_button_operator" android:text="@string/btn_equal" android:textColor="@color/calc_text_primary" android:textSize="24sp" />
        </TableRow>
    </TableLayout>
</LinearLayout>